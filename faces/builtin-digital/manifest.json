{
  "schemaVersion": 2,
  "id": "builtin-digital",
  "version": "1.2.0",
  "name": "Slow Hours",
  "description": "Digital clock with optional room temperature and night mode.",
  "author": "screensvr",
  "entry": "index.html",
  "inputs": [
    {
      "key": "roomTemperature",
      "label": "Room temperature",
      "type": "number",
      "quantity": "temperature",
      "description": "Optional temperature in the upper-right corner."
    }
  ],
  "settings": [
    {
      "key": "nightMode",
      "label": "Night mode",
      "type": "boolean",
      "default": false
    },
    {
      "key": "accent",
      "label": "Ambient color",
      "type": "color",
      "default": "#b4cdad"
    },
    {
      "key": "background",
      "label": "Background",
      "type": "color",
      "default": "#15231e"
    },
    {
      "key": "format",
      "label": "Time format",
      "type": "select",
      "default": "24",
      "options": [
        { "label": "24 hour", "value": "24" },
        { "label": "12 hour", "value": "12" }
      ]
    },
    {
      "key": "showSeconds",
      "label": "Show seconds",
      "type": "boolean",
      "default": false
    },
    {
      "key": "caption",
      "label": "Caption",
      "type": "text",
      "default": "Be here, now."
    }
  ]
}
