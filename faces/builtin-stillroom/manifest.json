{
  "schemaVersion": 2,
  "id": "builtin-stillroom",
  "version": "1.0.0",
  "name": "Stillroom",
  "description": "Serif digital clock with optional room temperature.",
  "author": "screensvr",
  "entry": "index.html",
  "inputs": [
    {
      "key": "roomTemperature",
      "label": "Room temperature",
      "type": "number",
      "quantity": "temperature",
      "description": "Optional room temperature; outdated readings are marked stale."
    }
  ],
  "settings": [
    {
      "key": "background",
      "label": "Night color",
      "type": "color",
      "default": "#101615"
    },
    {
      "key": "clockColor",
      "label": "Clock color",
      "type": "color",
      "default": "#c9c4b8"
    },
    {
      "key": "accent",
      "label": "Accent color",
      "type": "color",
      "default": "#98aa9a"
    },
    {
      "key": "format",
      "label": "Time format",
      "type": "select",
      "default": "24",
      "options": [
        { "label": "24 hour", "value": "24" },
        { "label": "12 hour", "value": "12" }
      ]
    },
    {
      "key": "showDate",
      "label": "Show date",
      "type": "boolean",
      "default": true
    },
    {
      "key": "roomLabel",
      "label": "Room label",
      "type": "text",
      "default": "In this room"
    },
    {
      "key": "motion",
      "label": "Ambient animation",
      "type": "boolean",
      "default": true
    }
  ]
}
