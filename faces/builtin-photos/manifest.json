{
  "schemaVersion": 3,
  "id": "builtin-photos",
  "version": "1.0.0",
  "name": "Photo Hours",
  "description": "Your photos or curated online backgrounds, with a quiet clock and image credits.",
  "author": "screensvr",
  "entry": "index.html",
  "inputs": [
    {
      "key": "photos",
      "label": "Photos",
      "description": "An album, folder, favorite image, or curated online background collection.",
      "type": "image",
      "attribution": true
    }
  ],
  "settings": [
    {
      "key": "interval",
      "label": "Seconds between photos",
      "type": "number",
      "default": 30,
      "min": 5,
      "max": 3600,
      "step": 1
    },
    {
      "key": "shuffle",
      "label": "Shuffle photos",
      "type": "boolean",
      "default": true
    },
    {
      "key": "fit",
      "label": "Photo fit",
      "type": "select",
      "default": "cover",
      "options": [
        { "label": "Fill screen", "value": "cover" },
        { "label": "Show whole photo", "value": "contain" }
      ]
    },
    {
      "key": "showClock",
      "label": "Show clock",
      "type": "boolean",
      "default": true
    },
    {
      "key": "format",
      "label": "Clock format",
      "type": "select",
      "default": "24",
      "options": [
        { "label": "24 hour", "value": "24" },
        { "label": "12 hour", "value": "12" }
      ]
    }
  ]
}
