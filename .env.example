# These are read by the Node process, not automatically loaded from .env.
HOST=0.0.0.0
PORT=3000
SCREENSVR_DATA_DIR=./data
# Behind an HTTPS reverse proxy, configure its public origin and secure cookies:
# SCREENSVR_ORIGIN=https://screensvr.example.com
# SCREENSVR_SECURE_COOKIES=true
# Only enable when the server is reachable exclusively through a trusted proxy:
# SCREENSVR_TRUST_PROXY=true
